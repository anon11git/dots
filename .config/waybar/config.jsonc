{
    "layer": "top",
    "output": [ "*" ],
    "position": "top",
    "mod": "dock",
    "height": 30,
    "exclusive": true,
    "passthrough": false,
    "gtk-layer-shell": true,
    "reload_style_on_change": true,
    "modules-left": ["custom/padd","custom/l_end","cpu","memory","custom/r_end","custom/l_end","hyprland/workspaces","custom/r_end","custom/padd"],
    "modules-center": ["custom/padd","custom/l_end","clock","custom/r_end","custom/padd"],
    "modules-right": ["custom/padd","custom/l_end","backlight","network","pulseaudio","custom/r_end","custom/l_end","privacy","tray","battery","custom/r_end","custom/padd"],

    "cpu": {
        "interval": 10,
        "format": "󰍛 {usage}%",
    },

    "memory": {
        "states": {
            "c": 90,
            "h": 60,
            "m": 30,
        },
        "interval": 10,
        "format": "󰾆 {used}",
        "format-m": "󰾅 {used}GB",
        "format-h": "󰓅 {used}GB",
        "format-c": " {used}GB",
        "tooltip-format": "{percentage}%\n{total:0.1f}GB"
    },

    "clock": {
        "format": "{:%H:%M}",
    },

"hyprland/workspaces": {
        "all-outputs": true,
        "active-only": false,
        "disable-scroll": false,
    },

"backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""],
    },

    "network": {
        "tooltip": true,
        "format": "<span foreground='#000000'> {bandwidthDownBytes}</span> <span foreground='#777777'> {bandwidthUpBytes}</span> ",
        "tooltip-format": "<big><b>{essid}</b></big>\n <b>{signaldBm}dBm ({signalStrength}%)</b>\nFrequency: <b>{frequency}MHz</b>\nInterface: <b>{ifname}</b>\nIP: <b>{ipaddr}/{cidr}</b>\nGateway: <b>{gwaddr}</b>\nNetmask: <b>{netmask}</b>",
        "format-linked": "󰈀 {ifname} (No IP)",
        "format-disconnected": "󰖪 ",
        "interval": 1,
    },

"pulseaudio": {
    "format": "{icon} {volume}",
    "rotate": 0,
    "format-muted": "婢",
    "tooltip-format": "{icon} {desc}",
    "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "phone": "",
        "portable": "",
        "car": "",
        "default": ["", "", ""]
    }
},

"privacy": {
        "icon-size": 14,
        "icon-spacing": 5,
        "transition-duration": 250,
        "modules": [
            {
                "type": "screenshare",
            },
            {
                "type": "audio-in",
           }
        ]
    },

    "tray": {
        "icon-size": 18,
        "spacing": 5
    },

    "battery": {
        "states": {
            "good": 95,
            "warning": 30,
            "critical": 20
        },
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-alt": "{time}",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },

    "custom/l_end": {
        "format": " ",
        "interval" : "once",
    },

    "custom/r_end": {
        "format": " ",
        "interval" : "once",
    },

    "custom/sl_end": {
        "format": " ",
        "interval" : "once",
    },

    "custom/sr_end": {
        "format": " ",
        "interval" : "once",
    },

    "custom/rl_end": {
        "format": " ",
        "interval" : "once",
    },

    "custom/rr_end": {
        "format": " ",
        "interval" : "once",
    },

    "custom/padd": {
        "format": "  ",
        "interval" : "once",
    }

}
